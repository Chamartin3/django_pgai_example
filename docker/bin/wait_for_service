#!/usr/bin/env python3

import sys
import socket
import urllib.parse
import time


def wait_for_service(service_url, service_name):
    print(f"Waiting for {service_name} at {service_url}...")
    url = urllib.parse.urlparse(service_url)
    while True:
        try:
            with socket.create_connection(
                (url.hostname, url.port),
                timeout=5
            ) as sock:
                print(f"{service_name} is available")
                return
        except (socket.timeout, socket.error):
            print(f"{service_name} is not available yet. Retrying in 2 seconds...")
            time.sleep(2)


if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("Usage: python wait_for_service.py <SERVICE_URL> <SERVICE_NAME>")
        sys.exit(1)

    service_url = sys.argv[1]
    service_name = sys.argv[2]
    wait_for_service(service_url, service_name)
